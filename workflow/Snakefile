from pathlib import Path
configfile: "config/config.yaml"

include: "rules/common.smk"

rule all:
    input:
        expand("data/mzml/{sample}.mzML", sample=SAMPLES),
        expand("results/features/{sample}.featureXML",sample=SAMPLES),
        expand("results/features/{sample}_features.tsv", sample=SAMPLES),
        expand("results/aligned/{sample}_rt_aligned.featureXML", sample=SAMPLES),
        expand("results/adducts/{sample}_adducts.featureXML", sample=SAMPLES),
        f"results/consensus/{config['consensus_file_name']}",
        f"results/final/{config['final_feature_matrix']}",
        f"results/final/{config['output_msp_file']}"

rule export_feature_matrix:
    input:
        consensus=f"results/consensus/{config['consensus_file_name']}"
    output:
        matrix=f"results/final/{config['final_feature_matrix']}"
    script:
        "scripts/export_feature_matrix.py"

rule ms2_pairing:
    input:
        consensus=f"results/consensus/{config['consensus_file_name']}",
        features=expand("results/adducts/{sample}_adducts.featureXML", sample=SAMPLES),
        mzml=expand("data/mzml/{sample}.mzML", sample=SAMPLES)
    params:
        samples=SAMPLES,
        ms2=config["ms2_pairing"]
    output:
        msp=f"results/final/{config['output_msp_file']}"
    script:
        "scripts/ms2_pairing.py"

rule link_features:
    input:
        aligned_features=expand("results/adducts/{sample}_adducts.featureXML", sample=SAMPLES)
    params:
        samples=SAMPLES,
        linking_settings=config["feature_linking"]
    output:
        consensus=f"results/consensus/{config['consensus_file_name']}"
    script:
        "scripts/link_features.py"

rule detect_adducts:
    input:
        features="results/aligned/{sample}_rt_aligned.featureXML",
        mzml="data/mzml/{sample}.mzML"  # read for ion polarity only
    output:
        features="results/adducts/{sample}_adducts.featureXML",
        groups="results/adducts/{sample}_adduct_groups.consensusXML"
    params:
        mfd=config["metabolite_feature_deconvolution"]
    script:
        "scripts/detect_adducts.py"

rule align_features:
    input:
        featureXML=expand("results/features/{sample}.featureXML", sample=SAMPLES)
    output:
        aligned=expand("results/aligned/{sample}_rt_aligned.featureXML", sample=SAMPLES)
    params:
        samples=SAMPLES,
        aln=config["map_alignment_pose_clustering"],
        trafo=config["map_alignment_transformer"]
    script:
        "scripts/align_features.py"

rule detect_features:
    input:
        mzml="data/mzml/{sample}.mzML"
    output:
        features="results/features/{sample}.featureXML"
    params:
        mtd=config["mass_trace_detection"],
        epd=config["elution_peak_detection"],
        ffm=config['feature_finding_metabo']
    script:
        "scripts/detect_features.py"

rule export_sample_features:
    input:
        features="results/features/{sample}.featureXML"
    output:
        table="results/features/{sample}_features.tsv"
    script:
        "scripts/export_sample_features.py"

rule convert_raw:
    input:
        raw="data/raw/{sample}.raw"
    output:
        mzml="data/mzml/{sample}.mzML"
    params:
        mount=f"{Path('data').resolve()}:/data",
        raw_in_container=lambda wildcards: f"/data/raw/{wildcards.sample}.raw"
    shell:
        """
        mkdir -p data/mzml
        docker run --rm --platform linux/amd64 \
            -e WINEDEBUG=-all \
            -v {params.mount:q} \
            proteowizard/pwiz-skyline-i-agree-to-the-vendor-licenses \
            wine msconvert {params.raw_in_container:q} \
            --mzML --zlib \
            --filter "peakPicking vendor msLevel=1-" \
            -o /data/mzml
        """
